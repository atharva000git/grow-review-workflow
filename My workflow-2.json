    {
      "parameters": {
        "jsCode": "const raw = $('Basic LLM Chain').first().json.text;\nconst d = JSON.parse(raw.replace(/```json|```/g, '').trim());\nconst today = '2026-11-20';\n\nconst quotes = [\n  { id: '9f5b56bf-43de-4e69-8b74-613b1fc79ba6', q: 'lagging chart' },\n  { id: 'd44fe8e4-fb0b-462e-8ebb-e3cde86f440f', q: 'app stuck problem 5min chart not working' },\n  { id: '153c280d-8715-4aa0-8ceb-c80a023c77d2', q: 'borkar jada hai20 ki jagah 10' }\n];\nconst links = [\n  'https://groww.in/pricing',\n  'https://groww.in/help/payments/payments-charges/why-is-my-brokerage-more-than-20-rupees--71'\n];\nconst top = d.top_3_themes.map(t => `${t.name} (${t.count}/25)`).join('; ');\n\nconst pulse =\n`Weekly Product Pulse (GROW, sample of 25 reviews, Aug 24 - Oct 17 2026)\nTop themes: ${top}.\nQuotes:\n${quotes.map(x => `- \"${x.q}\" (${x.id})`).join('\\n')}\nKey observation: ${d.key_observation}\nActions:\n${d.action_ideas.map((a, i) => `${i + 1}. ${a}`).join('\\n')}`;\n\nconst fee =\n`Fee issue: ${d.identified_fee_issue}\nBrokerage explainer:\n${d.explanation_bullets.map(b => `- ${b}`).join('\\n')}\nSources: ${links.join(' | ')}\nLast checked: ${today}`;\n\nconst notion_content = `${pulse}\\n\\n${fee}`;\n\nreturn [{ json: {\n  date: today,\n  top_themes: d.top_3_themes.map(t => t.name),\n  weekly_pulse: pulse,\n  identified_fee_issue: d.identified_fee_issue,\n  explanation_bullets: d.explanation_bullets,\n  source_links: links,\n  notion_content,\n  email_subject: 'Weekly Product Pulse + Customer Clarification — GROW',\n  email_body: `${pulse}\\n\\n--- Support snippet ---\\n${fee}`\n}}];"
      },
