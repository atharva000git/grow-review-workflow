    {
      "parameters": {
        "jsCode": "const reviews = $input.first().json.reviews ?? [];\n\nconst recentReviews = reviews\n  .filter(r => r.date >= '2026-08-24')\n  .sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''));\n\nconst sampleSize = Math.min(25, recentReviews.length);\n\nconst sample = Array.from({ length: sampleSize }, (_, i) => {\n  const index = sampleSize === 1\n    ? 0\n    : Math.round(i * (recentReviews.length - 1) / (sampleSize - 1));\n  return recentReviews[index];\n});\n\nreturn [{\n  json: {\n    reviews: sample,\n    recent_review_count: recentReviews.length,\n    sample_count: sample.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
